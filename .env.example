# Параметры demo-сервиса «Доставка» (BE-016)
# Порт, на котором сервис отвечает; должен совпадать с REDIRECT_URI и
# redirect_uris клиента delivery в backend/oauth-clients.example.json.
PORT=8090
# Адрес backend Vault. Для локального запуска Go — localhost;
# для docker compose на Windows/macOS — http://host.docker.internal:8080
VAULT_URL=http://localhost:8080
# Идентификатор OAuth-клиента (должен быть в конфиге клиентов Vault)
CLIENT_ID=delivery
# Адрес возврата после экрана согласия
REDIRECT_URI=http://localhost:8090/callback
# Запрашиваемые scopes (= ключи полей Vault)
SCOPES=full_name,email,phone,address
